#!/usr/bin/env bash
# ==============================================================================
# Pre-Commit Quality & Secret Leak Guard (Husky equivalent for Manasvia Backend)
# ==============================================================================

# 1. Prevent committing secrets or sensitive environment files
FORBIDDEN_PATTERNS=("\.env$" "\.env\..*" "secrets\.properties$" "\.secret$" "\.keystore$" "\.jks$" "google-services\.json$")

STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ "$file" =~ $pattern ]]; then
            echo -e "\033[0;31m[SECURITY ERROR] Attempting to commit sensitive file: $file\033[0m"
            echo -e "Secrets, environment credentials, and keystores must never be committed to Git."
            exit 1
        fi
    done
done

# 2. Check for unresolved merge conflict markers in source code
CONFLICT_PATTERN="<""<""<""<""<""<""< HEAD"
CONFLICT_FILES=$(git diff --cached --name-only -S"$CONFLICT_PATTERN" | grep -v "\.githooks/" | grep -v "\.md$" || true)
if [[ -n "$CONFLICT_FILES" ]]; then
    echo -e "\033[0;31m[ERROR] Staged files contain unresolved merge conflict markers:\033[0m"
    echo "$CONFLICT_FILES"
    exit 1
fi

exit 0
