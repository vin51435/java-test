# ==============================================================================
# Manasvia Backend - Environment Template (.env.example)
# Copy to .env to override local developer defaults if needed.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL + pgvector Configuration (Host Port 5433 -> Container Port 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=manasvia_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI & LLM Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Stateless Security
JWT_SECRET=your_super_secret_256_bit_cryptographic_key_here
